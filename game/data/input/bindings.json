{
  "_note": "Default controls. Players override any action in settings.cfg, section [input], e.g. end_turn=\"key:Enter, joy_button:a\". Formats: key:<Godot key name>, joy_button:<a|b|x|y|back|start|left_shoulder|right_shoulder|dpad_up|dpad_down|dpad_left|dpad_right|number>, joy_axis:<left_x|left_y|right_x|right_y><+|->. See docs/INPUT.md.",
  "actions": {
    "move_up":     {"label": "Move up",          "bind": ["key:W", "key:Up", "joy_button:dpad_up", "joy_axis:left_y-"]},
    "move_down":   {"label": "Move down",        "bind": ["key:S", "key:Down", "joy_button:dpad_down", "joy_axis:left_y+"]},
    "move_left":   {"label": "Move left",        "bind": ["key:A", "key:Left", "joy_button:dpad_left", "joy_axis:left_x-"]},
    "move_right":  {"label": "Move right",       "bind": ["key:D", "key:Right", "joy_button:dpad_right", "joy_axis:left_x+"]},
    "end_turn":    {"label": "End turn",         "bind": ["key:Space", "joy_button:a"]},
    "switch_hero": {"label": "Switch hero",      "bind": ["key:Tab", "joy_button:x"]},
    "talk":        {"label": "Talk to the GM",   "bind": ["key:Enter", "key:Kp Enter", "joy_button:y"]},
    "cancel":      {"label": "Leave text box",   "bind": ["key:Escape", "joy_button:b"]},
    "restart":     {"label": "New delve (after a loss)", "bind": ["key:R", "joy_button:start"]},
    "quick_save":  {"label": "Quick save",       "bind": ["key:F5"]},
    "quick_load":  {"label": "Quick load",       "bind": ["key:F9"]},
    "save_replay": {"label": "Save a replay (for bug reports)", "bind": ["key:F12"]},
    "debug_overlay": {"label": "Debug: stats overlay",        "bind": ["key:F1"], "debug": true},
    "debug_spawn":   {"label": "Debug: spawn a monster",      "bind": ["key:F2"], "debug": true},
    "debug_heal":    {"label": "Debug: heal the party",       "bind": ["key:F3"], "debug": true},
    "debug_clear":   {"label": "Debug: end the fight",        "bind": ["key:F4"], "debug": true},
    "debug_slowmo":  {"label": "Debug: slow-motion animation", "bind": ["key:F7"], "debug": true},
    "debug_reload":  {"label": "Debug: reload data, art and sound", "bind": ["key:F8"], "debug": true}
  }
}
